# Local-only overrides
**/settings.local.json
**/*.local.json

# --- Overlays (see docs/overlay.md) ---
# Overlay clones, their registry and the applied-state records hold
# environment-specific data, often from private repos. Never tracked here.
overlays/

# Rendered from a tracked base plus enabled overlays. Claude Code also writes
# runtime state (autoMode.environment) straight into the settings file, which
# is exactly what must not reach a public repo. The trailing * takes in the
# copies people make by hand (.bak, .bak.<timestamp>, .orig, ~): they hold
# the same content. The tracked .base. sources do not match it.
claude/settings.json*
shared/mcp/servers.json*
shared/memory/MEMORY.md
# Codex writes trusted project paths into its config, and the render puts
# overlay MCP servers there, credentials included.
codex/config.toml*
codex/AGENTS.override.md
*.render-tmp

# PyPI credentials — must NEVER end up in this repo. Belt-and-suspenders
# alongside the canonical ~/.pypirc location.
.pypirc
**/.pypirc

# --- Claude Code runtime state ---
# These directories and files are written by Claude Code at runtime once
# ~/.claude is symlinked to agents/claude. We don't track them in git.
claude/.credentials.json
claude/.last-cleanup
claude/.last-update-result.json
claude/history.jsonl
claude/policy-limits.json
claude/policy-limits.json.*
claude/mcp-needs-auth-cache.json
claude/remote-settings.json
claude/remote-settings.json.*
claude/backups/
claude/cache/
claude/downloads/
claude/file-history/
claude/paste-cache/
claude/plans/
claude/session-env/
claude/session-logs/
claude/sessions/
claude/shell-snapshots/
claude/tasks/
claude/telemetry/
claude/state/
# Installed plugins, their caches and registries. Claude Code writes all of
# it, and the registries hold this machine's absolute paths.
claude/plugins/
claude/daemon-auth-cooldown
claude/daemon-auth-status.json
claude/stats-cache.json
claude/gh-pr-status-cache.json
# SendFeedback drafts and Artifact scratch pages.
claude/feedback/
claude/scratchpads/
# Per-session timestamps written by the timestamp-{prompt,stop} hooks.
claude/.timestamp-state/
# Background job/daemon runtime state (control.key is a secret — never track).
claude/jobs/
claude/daemon/
claude/daemon.lock
claude/daemon.log
claude/daemon.status.json
# Chrome native-messaging host, installed at runtime.
claude/chrome/
# Skill sync trash. Claude Code writes it into ~/.claude/skills, which is a
# symlink to universal/skills (the synced/ cache is ignored further down).
universal/skills/.trash/

# Per-project runtime state. install.sh links some of the memory/
# directories in here to shared/memory, but the slugs are per machine, so
# those links are recreated by the installer rather than tracked.
claude/projects/

# --- Codex runtime state ---
# Login tokens; the * takes in a copy made by hand, which holds the same.
codex/auth.json*
codex/sessions/
codex/memories/
codex/history.jsonl
codex/log/
codex/cache/
codex/tmp/
codex/.tmp/
codex/shell_snapshots/
codex/installation_id
codex/version.json
codex/models_cache.json
codex/.personality_migration
codex/logs_*.sqlite*
codex/state_*.sqlite*
# The rest of Codex's per-machine state. thread_history_*.sqlite in particular
# holds the text of past conversations — it reached 9 MB here — and none of
# this belongs in a public repo.
codex/*.sqlite
codex/*.sqlite-shm
codex/*.sqlite-wal
# Codex 0.163 also copies them into db-backups/, and a copy is as private as
# the original.
codex/db-backups/
codex/session_index.jsonl
codex/.sandbox_migration
codex/rules/
codex/plugins/
codex/mcp-oauth-locks/
codex/thread-writer-locks/
codex/tui-thread-reference-capabilities/
codex/.sqlite-maintenance.lock
# The app-server daemon: its control socket, pid files and logs, and the
# release binaries it downloads (two releases took 834 MB here).
codex/app-server-control/
codex/app-server-daemon/
codex/packages/
# Codex's bundled system skills (plugin-creator, skill-creator, openai-docs,
# imagegen, skill-installer) live under codex/skills/.system/. Codex manages
# that subdirectory itself; user-added skills under codex/skills/<name>/ stay
# tracked. Our canonical skill location is universal/skills/.
codex/skills/.system/

# --- OpenCode runtime state ---
opencode/auth/
opencode/cache/
opencode/sessions/
opencode/log/
opencode/state/
# oh-my-openagent plugin's auto-migration backups and ledger files
opencode/*.backup-*
opencode/*.bak.*
opencode/*.migrations.json

# --- Gemini runtime state ---
gemini/oauth_creds.json
gemini/installation_id
gemini/tmp/
gemini/google_accounts.json

# --- Editor noise ---
.DS_Store
*.swp
*.swo

# --- Python bytecode + build artifacts ---
__pycache__/
*.py[cod]
mcp/dist/
mcp/build/
mcp/**/*.egg-info/
mcp/.codeindex/

# Skills the CLIs sync down from a marketplace, and per-project state they
# write. Neither is authored here.
universal/skills/synced/
gemini/projects.json

# Skills that are a symlink into a separately installed tool. The tool has its
# own upstream, so an overlay's setup step clones it and makes the link — the
# link is machine setup, not content this repo carries.
universal/skills/bell
universal/skills/noti

# claude-account-switcher install.sh backups (~/.claude symlinks into this repo)
*.pre-claude-auto.*.bak

# >>> worklog >>>
claude/worklog/
# <<< worklog <<<

# pre-compact-branch hook state (machine-local registry)
claude/hooks/state/
